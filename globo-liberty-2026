rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /visitantes/{document=**} {
      allow read, write: if true;
    }
    match /storico-citta-mondo/{document=**} {
      allow read, write: if true;
    }
    match /visitatori/{document} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['city', 'country', 'lat', 'lon', 'timestamp'])
                    && request.resource.data.timestamp is number
                    && request.resource.data.lat is number
                    && request.resource.data.lon is number;
      allow update, delete: if false;
    }
    match /radar_presenze/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['nick', 'xatId', 'os', 'city', 'country', 'code', 'lat', 'lon', 'lastSeen'])
                            && request.resource.data.lastSeen is number;
      allow delete: if true;
    }
  }
}
