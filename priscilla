<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EL CARTAIO</title>

<style>
html,body{
    margin:0;
    padding:0;
    background: transparent !important; /* sfondo trasparente pulito */
    overflow: hidden;
}

/* CONTENITORI VIDEO */
.video-box{
    position:fixed;
    width:240px;
    height:520px;
    top:50%;
    transform:translateY(-50%);
    border-radius:14px;
    border:2px solid #ff0000; /* solo rosso */
    box-shadow:none; /* tolta sfumatura */
    overflow:hidden;
    z-index:9999;
}

/* POSIZIONE */
.video-left{left:10px;}
.video-right{right:10px;}

/* VIDEO CON ZOOM PER COPRIRE EVENTUALI SCRITTE AI BORDI */
.video-box video{
    width:100%;
    height:100%;
    object-fit: cover;
    transform: scale(1.15); /* Zoom leggero per coprire scritte/testi */
    object-position: center;
    display:block;
}

/* TESTO ARCOBALENO FLUTTUANTE */
.video-text{
    position:absolute;
    bottom:12px;
    left:0;
    width:100%;
    text-align:center;
    font-size:24px;
    font-weight:900;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    letter-spacing: 1px;
    pointer-events:none;
    z-index: 10;
    
    /* Gradiente arcobaleno in movimento */
    background: linear-gradient(90deg, #ff0000, #ff7f00, #ffff00, #00ff00, #00ffff, #0000ff, #8b00ff, #ff0000);
    background-size: 400% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    
    /* Animazioni combinate: onda di fluttuazione + scorrimento arcobaleno */
    animation: wave 3s ease-in-out infinite, rainbowMove 6s linear infinite;
    
    /* Leggero bagliore per far risaltare il testo sopra il video */
    filter: drop-shadow(0 0 4px rgba(0,0,0,0.8));
}

/* ANIMAZIONE ONDA (FLUTTUAZIONE) */
@keyframes wave{
    0%{transform:translateY(0) rotate(0deg);}
    25%{transform:translateY(-6px) rotate(-1.5deg);}
    50%{transform:translateY(0) rotate(0deg);}
    75%{transform:translateY(6px) rotate(1.5deg);}
    100%{transform:translateY(0) rotate(0deg);}
}

/* ANIMAZIONE SFUMATURA ARCOBALENO */
@keyframes rainbowMove{
    0%{background-position: 0% center;}
    100%{background-position: 400% center;}
}
</style>
</head>

<body>

<!-- VIDEO SINISTRO -->
<div class="video-box video-left">
    <video autoplay loop muted playsinline>
        <source src="https://i.imgur.com/A3sIDl4.mp4" type="video/mp4">
    </video>
    <div class="video-text">NATIVA94</div>
</div>

<!-- VIDEO DESTRO -->
<div class="video-box video-right">
    <video autoplay loop muted playsinline>
        <source src="https://i.imgur.com/A3sIDl4.mp4" type="video/mp4">
    </video>
    <div class="video-text">NATIVA94</div>
</div>

</body>
</html>
