<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>EDITION 2026 - ZENO LIVE</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap');
        :root {
            --rainbow: linear-gradient(45deg, #ff0000, #ff7300, #fffb00, #48ff00, #00ffd5, #002bff, #7a00ff, #ff00c8, #ff0000);
            --accent: #ff00c8;
            --btn-grad: linear-gradient(to right, #ff00c8, #ff7300);
            --rb-text: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #f0f, #f00);
        }
        * { box-sizing: border-box; }
        body {
            background: transparent !important;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Arial Black', sans-serif;
            overflow: hidden;
        }
        .main-chassis {
            position: relative;
            width: 730px;
            height: 640px;
            background: radial-gradient(circle at center, #1a1a20 0%, #050505 100%);
            border-radius: 30px;
            padding: 15px;
            display: grid;
            grid-template-columns: 180px 1fr 180px;
            gap: 10px;
            border: 2px solid rgba(255,255,255,0.1);
            box-shadow: 0 0 30px var(--accent), inset 0 0 50px #000;
            z-index: 1;
            transition: box-shadow 0.4s ease;
        }
        .main-chassis::after {
            content: '';
            position: absolute;
            inset: -3px;
            border-radius: 33px;
            padding: 3px;
            background: var(--rainbow);
            background-size: 400%;
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            animation: rb-move 8s linear infinite;
            z-index: -1;
        }
        .main-chassis.rainbow-mode {
            box-shadow: 0 0 35px #ff00c8, 0 0 55px #00ffd5, inset 0 0 50px #000;
        }
        .main-chassis.rainbow-mode .display-top,
        .main-chassis.rainbow-mode .box,
        .main-chassis.rainbow-mode .control-bar,
        .main-chassis.rainbow-mode .eq-container,
        .main-chassis.rainbow-mode #locandina {
            border-color: #00ffd5 !important;
            box-shadow: 0 0 15px rgba(0, 255, 213, 0.5), inset 0 0 10px #000 !important;
        }
        .main-chassis.rainbow-mode .vinyl,
        .main-chassis.rainbow-mode .woofer-pro {
            box-shadow: 0 0 20px #ff7300, 0 0 30px #00ffd5 !important;
        }
        .display-top {
            grid-column: 1 / 4;
            height: 60px;
            background: rgba(0,0,0,0.9);
            border: 2px solid var(--accent);
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            display: flex;
            align-items: center;
            transition: border-color 0.4s ease, box-shadow 0.4s ease;
        }
        .marquee-box { 
            display: flex; 
            width: 100%; 
            white-space: nowrap; 
            animation: bounce-scroll 10s ease-in-out infinite alternate; 
        }
        .rainbow-text {
            font-size: 22px;
            font-weight: 900;
            text-transform: uppercase;
            background: var(--rainbow);
            background-size: 200%;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: rb-move 3s linear infinite;
            padding: 0 30px;
            display: inline-block;
        }
        @keyframes bounce-scroll { 0% { transform: translateX(30%); } 100% { transform: translateX(-30%); } }
        .box {
            background: rgba(255,255,255,0.03);
            border: 1.5px solid var(--accent);
            border-radius: 10px;
            padding: 6px;
            text-align: center;
            height: 52px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            transition: transform 0.2s, border-color 0.4s ease;
        }
        .box h4 { margin: 0; font-size: 8px; color: #bf953f; text-transform: uppercase; letter-spacing: 1px; }
        .box span { font-size: 11px; font-weight: bold; display: block; margin-top: 3px; color: #fff; text-shadow: 0 0 8px var(--accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .copyable { cursor: pointer; }
        .copyable:hover { transform: scale(1.03); border-color: #00ffd5; }
        
        /* PIATTO VINILE */
        .turntable { position: relative; display: flex; justify-content: center; align-items: center; }
        .vinyl { 
            position: relative;
            width: 270px; 
            height: 270px; 
            border-radius: 50%; 
            border: 6px solid #0a0a0a; 
            box-shadow: 0 0 30px var(--accent); 
            overflow: hidden; 
            background: #000; 
            transition: box-shadow 0.4s ease; 
        }
        #album-art { 
            width: 100%; 
            height: 100%; 
            border-radius: 50%; 
            object-fit: cover; 
            display: block;
        }
        .vinyl-hole {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 22px;
            height: 22px;
            background: #111;
            border: 2px solid rgba(255, 255, 255, 0.7);
            border-radius: 50%;
            box-shadow: inset 0 0 5px #000;
            z-index: 5;
            pointer-events: none;
        }
        
        .arm {
            position: absolute;
            width: 110px;
            height: 250px;
            right: -50px;
            top: 40px;
            background: url('https://peppeagosto.github.io/braccetto.png');
            background-size: contain;
            background-repeat: no-repeat;
            transform-origin: top right;
            transform: rotate(-25deg);
            transition: 1.5s cubic-bezier(0.45, 0.05, 0.55, 0.95);
            z-index: 10;
        }
        .woofer-pro {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            background: linear-gradient(145deg, #2a2a2a, #0a0a0a);
            border: 3px solid #444;
            box-shadow: 0 0 15px var(--accent), inset 0 3px 8px #000;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.05s ease-out, box-shadow 0.4s ease;
            position: relative;
        }
        .woofer-pro::before {
            content: '';
            position: absolute;
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: radial-gradient(circle, #222 0%, #050505 100%);
            border: 1px solid #111;
            box-shadow: inset 0 3px 4px rgba(255,255,255,0.15), inset 0 -3px 4px rgba(0,0,0,0.9);
        }
        .cone {
            position: relative;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: conic-gradient(from 0deg, #111, #222, #111, #222, #111);
            box-shadow: inset 0 0 12px #000, 0 0 4px #000;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1;
        }
        .dust-cap {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 35%, #555 0%, #1a1a1a 50%, #000 100%);
            box-shadow: 0 2px 5px rgba(0,0,0,0.8);
        }
        .control-bar { grid-column: 1 / 4; display: flex; align-items: center; justify-content: space-between; background: rgba(0,0,0,0.9); border-radius: 40px; padding: 6px 18px; border: 2px solid var(--accent); transition: border-color 0.4s ease, box-shadow 0.4s ease;}
        .btn { background: var(--btn-grad); border: none; padding: 8px 16px; border-radius: 8px; font-weight: 900; cursor: pointer; font-size: 11px; color: #fff; text-shadow: 0 0 5px #000; box-shadow: 0 0 10px rgba(0, 242, 255, 0.5); user-select: none; }
        .btn:active { transform: scale(0.95); }
        input[type=range] { -webkit-appearance: none; width: 100px; height: 6px; background: var(--btn-grad); border-radius: 5px; outline: none; }
        .dot-box { display: flex; flex-direction: column; gap: 8px; justify-content: center; align-items: center; }
        .dot { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #fff; cursor: pointer; transition: 0.3s; }
        .dot:hover { transform: scale(1.15); box-shadow: 0 0 8px #fff; }
        .eq-container {
            grid-column: 1 / 4;
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 6px;
            height: 35px;
            background: rgba(0,0,0,0.85);
            border: 1.5px solid var(--accent);
            border-radius: 10px;
            padding: 4px;
            box-shadow: inset 0 0 10px #000;
            transition: border-color 0.4s ease, box-shadow 0.4s ease;
        }
        .eq-bar { width: 14px; height: 100%; background: rgba(255,255,255,0.05); border-radius: 3px; display: flex; flex-direction: column-reverse; gap: 2px; overflow: hidden; }
        .eq-segment { width: 100%; height: 5px; background: #222; border-radius: 1px; transition: background-color 0.05s ease; }
        .eq-segment.active-green { background: #00ff66; box-shadow: 0 0 5px #00ff66; }
        .eq-segment.active-yellow { background: #fffb00; box-shadow: 0 0 5px #fffb00; }
        .eq-segment.active-red { background: #ff0055; box-shadow: 0 0 5px #ff0055; }

        /* LOCANDINA CON FOTO 270x270 */
        #locandina { 
            display: none; 
            position: absolute; 
            top: 50%; 
            left: 50%; 
            transform: translate(-50%, -50%); 
            width: 380px; 
            max-height: 560px; 
            overflow-y: auto; 
            background: rgba(10, 10, 15, 0.98); 
            border: 3px solid var(--accent); 
            border-radius: 25px; 
            padding: 16px; 
            box-shadow: 0 0 45px var(--accent), inset 0 0 25px #000; 
            z-index: 99; 
            box-sizing: border-box; 
            transition: border-color 0.4s ease, box-shadow 0.4s ease;
        }
        .header { text-align: center; border-bottom: 2px solid #222; margin-bottom: 12px; padding-bottom: 6px; }
        #giorno-live { color: #ffff00; font-size: 14px; text-transform: uppercase; font-weight: bold; }
        .titolo { background: var(--rb-text); -webkit-background-clip: text; color: transparent; font-size: 13px; font-weight: 900; text-transform: uppercase; }
        
        .slot { 
            background: #08080c; 
            border: 2px solid #222; 
            border-radius: 20px; 
            margin-bottom: 18px; 
            padding: 12px; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            gap: 10px; 
            transition: all 0.3s ease; 
        }
        .slot-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            padding: 0 10px;
        }
        .ora { color: #00ffd5; font-size: 13px; font-weight: bold; }
        .nome { color: #ff00ff; font-size: 13px; text-transform: uppercase; font-weight: 900; display: flex; align-items: center; gap: 6px; }
        
        /* FOTO 270x270 PX ESATTI */
        .foto-container {
            position: relative;
            width: 270px;
            height: 270px;
            border-radius: 50%;
            overflow: hidden;
            border: 6px solid #222;
            box-shadow: 0 0 25px rgba(0,0,0,0.9);
            background: #000;
        }
        .foto { 
            width: 100%; 
            height: 100%; 
            border-radius: 50%; 
            object-fit: cover; 
            display: block;
        }
        .spinning { 
            animation: spin 4s linear infinite !important; 
        }
        .slot.live-active {
            border-color: #00ff66 !important;
            box-shadow: 0 0 20px rgba(0, 255, 102, 0.4) !important;
        }
        .slot.live-active .foto-container {
            border-color: #00ff66 !important;
            box-shadow: 0 0 25px #00ff66 !important;
        }
        
        .led-verde { width: 10px; height: 10px; background-color: #0f0; border-radius: 50%; display: inline-block; box-shadow: 0 0 10px #0f0; animation: blink 0.8s infinite; }
        .led-rosso { width: 10px; height: 10px; background-color: #f00; border-radius: 50%; display: inline-block; box-shadow: 0 0 8px #f00; }
        #close-pali { position: absolute; right: 12px; top: 10px; color: #fff; cursor: pointer; font-size: 14px; font-weight: bold; background: #f00; border-radius: 50%; width: 22px; height: 22px; text-align: center; line-height: 20px; }
        @keyframes rb-move { 0% { background-position: 0% 50%; } 100% { background-position: 200% 50%; } }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    </style>
</head>
<body>

<div class="main-chassis" id="player">
    <div class="display-top">
        <div class="marquee-box">
            <span id="scroll-text" class="rainbow-text">LIVE RADIO STREAMING</span>
        </div>
    </div>
    
    <div class="side-panel" style="display:flex; flex-direction:column; gap:8px; justify-content:center;">
        <div class="box"><h4>CLOCK</h4><span id="clock">00:00:00</span></div>
        <div class="box copyable" onclick="copySongInfo()"><h4>SINGER / DJ</h4><span id="artist">ON AIR</span></div>
        <div class="box copyable" onclick="copySongInfo()"><h4>SONG / TITLE</h4><span id="song">STREAMING</span></div>
    </div>
    
    <div class="turntable">
        <div class="vinyl" id="v-box">
            <img id="album-art" src="https://xatimg.com/image/or3rbqD5I3rS.png" alt="Cover Vinyl">
            <div class="vinyl-hole"></div>
        </div>
        <div id="arm" class="arm"></div>
    </div>
    
    <div style="display: flex; gap: 8px;">
        <div class="side-panel" style="display:flex; flex-direction:column; gap:8px; justify-content:center;">
            <div class="box"><h4>CITY / WEATHER</h4><span id="v_city">...</span></div>
            <div class="box"><h4>USER IP</h4><span id="v_ip">...</span></div>
            <div class="box"><h4>SHIELD</h4><span id="shield-text" style="color:#48ff00 !important; text-shadow: 0 0 10px #48ff00;">ENCRYPTED</span></div>
        </div>
        <div class="dot-box">
            <div class="dot" style="background:#ff7300;" onclick="setT('#ff7300')"></div>
            <div class="dot" style="background:#ff0000;" onclick="setT('#ff0000')"></div>
            <div class="dot" style="background:#fffb00;" onclick="setT('#fffb00')"></div>
            <div class="dot" style="background:#ff00c8;" onclick="setT('#ff00c8')"></div>
            <div class="dot" style="background:var(--rainbow); background-size:200%;" onclick="setT('rb')"></div>
        </div>
    </div>
    
    <div class="control-bar">
        <div class="woofer-pro" id="wl">
            <div class="cone"><div class="dust-cap"></div></div>
        </div>
        <button class="btn" id="playBtn" onclick="playAudio()">PLAY</button>
        <button class="btn" id="btn-pali">PALINSESTO</button>
        <input type="range" id="vol" min="0" max="1" step="0.01" value="0.8">
        <button class="btn" onclick="stopAudio()">STOP</button>
        <div class="woofer-pro" id="wr">
            <div class="cone"><div class="dust-cap"></div></div>
        </div>
    </div>
    
    <div class="eq-container" id="eq-display"></div>
    
    <div id="locandina">
        <div id="close-pali">×</div>
        <div class="header">
            <span id="giorno-live">---</span>
            <div class="titolo" id="titolo-locandina">DIRETTE RADIO LIVE</div>
        </div>
        <div id="lista-dj"></div>
    </div>
</div>

<script>
    // MOTORE AUDIO
    const audio = new Audio("https://stream.zeno.fm/ylkruiq5e4fvv");
    audio.crossOrigin = "anonymous";
    audio.volume = 0.8;
    
    let isPlaying = false;
    let audioCtx, analyser, dataArray;
    let animId;
    let currentDjLivePhoto = null;

    // COSTRUZIONE EQUALIZZATORE
    const eqContainer = document.getElementById('eq-display');
    for(let i = 0; i < 12; i++) {
        let bar = document.createElement('div');
        bar.className = 'eq-bar';
        for(let j = 0; j < 5; j++) {
            let seg = document.createElement('div');
            seg.className = 'eq-segment';
            bar.appendChild(seg);
        }
        eqContainer.appendChild(bar);
    }

    // PLAY
    async function playAudio() {
        if(!isPlaying){
            await audio.play().catch(()=>{});
            isPlaying = true;
            document.getElementById('album-art').classList.add('spinning');
            document.querySelectorAll('#lista-dj .foto').forEach(f => f.classList.add('spinning'));
            document.getElementById('arm').style.transform = "rotate(15deg)";
            
            if(!audioCtx){
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                analyser = audioCtx.createAnalyser();
                analyser.fftSize = 256;
                const source = audioCtx.createMediaElementSource(audio);
                source.connect(analyser);
                analyser.connect(audioCtx.destination);
                dataArray = new Uint8Array(analyser.frequencyBinCount);
            }
            if(audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            animaVisualizer();
        }
    }

    // STOP
    function stopAudio() {
        if(isPlaying){
            audio.pause();
            audio.currentTime = 0;
            isPlaying = false;
            document.getElementById('album-art').classList.remove('spinning');
            document.querySelectorAll('#lista-dj .foto').forEach(f => f.classList.remove('spinning'));
            document.getElementById('arm').style.transform = "rotate(-25deg)";
            if (animId) cancelAnimationFrame(animId);
            resetVisualizer();
        }
    }

    // VOLUME
    document.getElementById("vol").oninput = e => { audio.volume = e.target.value; };

    // VISUALIZER EQUALIZZATORE
    function animaVisualizer() {
        if (!isPlaying) return;
        
        analyser.getByteFrequencyData(dataArray);

        let bass = (dataArray[0] + dataArray[1] + dataArray[2] + dataArray[3]) / 4;
        let scale = 1 + (bass / 255) * 0.18;
        document.getElementById('wl').style.transform = `scale(${scale.toFixed(3)})`;
        document.getElementById('wr').style.transform = `scale(${scale.toFixed(3)})`;

        const bars = document.querySelectorAll('.eq-bar');
        bars.forEach((bar, i) => {
            let val = dataArray[i * 3] || 0; 
            let activeLevel = Math.round((val / 255) * 5.5);

            let segments = bar.querySelectorAll('.eq-segment');
            segments.forEach((seg, sIdx) => {
                seg.className = 'eq-segment';
                if(sIdx < activeLevel) {
                    if(sIdx < 3) seg.classList.add('active-green');
                    else if(sIdx < 4) seg.classList.add('active-yellow');
                    else seg.classList.add('active-red');
                }
            });
        });

        animId = requestAnimationFrame(animaVisualizer);
    }

    function resetVisualizer() {
        document.getElementById('wl').style.transform = `scale(1)`;
        document.getElementById('wr').style.transform = `scale(1)`;
        document.querySelectorAll('.eq-segment').forEach(s => s.className = 'eq-segment');
    }

    // LETTURA METADATI
    async function updateTitleCover() {
        try {
            const res = await fetch("https://zenoplay.zenomedia.com/api/zenofm/nowplaying/ylkruiq5e4fvv");
            const data = await res.json();
            
            if (data && data.title && data.title.trim() !== "") {
                const titolo = data.title.trim();
                document.getElementById('scroll-text').innerText = titolo.toUpperCase();
                
                let artista = "ON AIR";
                let canzone = titolo;
                if (titolo.includes(" - ")) {
                    const parts = titolo.split(" - ");
                    artista = parts[0].trim();
                    canzone = parts.slice(1).join(" - ").trim();
                } else {
                    artista = titolo;
                    canzone = "LIVE STREAM";
                }
                document.getElementById('artist').innerText = artista.toUpperCase();
                document.getElementById('song').innerText = canzone.toUpperCase();

                if (currentDjLivePhoto) {
                    document.getElementById('album-art').src = currentDjLivePhoto;
                    return;
                }

                if (titolo.includes(" - ")) {
                    const a = encodeURIComponent(artista);
                    const b = encodeURIComponent(canzone.replace(/\[.*?\]|\(.*?\)/g, "").trim());
                    const itunesRes = await fetch(`https://itunes.apple.com/search?term=${a}+${b}&media=music&limit=1`);
                    const itunesData = await itunesRes.json();
                    if (itunesData.resultCount > 0) {
                        document.getElementById('album-art').src = itunesData.results[0].artworkUrl100.replace("100x100bb", "600x600bb");
                        return;
                    }
                }
            }
        } catch(e) {}
    }
    updateTitleCover();
    setInterval(updateTitleCover, 8000);

    // PALINSESTO COMPLETO
    const giorni = ["DOMENICA", "LUNEDI", "MARTEDI", "MERCOLEDI", "GIOVEDI", "VENERDI", "SABATO"];
    const giorniAccenti = ["DOMENICA", "LUNEDÌ", "MARTEDÌ", "MERCOLEDÌ", "GIOVEDÌ", "VENERDÌ", "SABATO"];
    
    let databaseTurni = {
      "VENERDÌ": [
        { "h": 11, "n": "DJ GHOST", "f": "https://xatimg.com/image/hUZaRGNEsUOR.jpg" },
        { "h": 12, "n": "DJ GHOST", "f": "https://xatimg.com/image/4tWxOKBtaFT4.png" },
        { "h": 13, "n": "DJ GHOST", "f": "https://xatimg.com/image/AEZOfU2tUn5M.png" },
        { "h": 14, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 22, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 23, "n": "DJ MILENA", "f": "https://xatimg.com/image/SC3mpxS2WjsX.png" },
        { "h": 0, "n": "DJ GENNY", "f": "https://xatimg.com/image/ahgYi39SeIi4.jpg" },
        { "h": 1, "n": "DJ ROSA", "f": "https://xatimg.com/image/ZLS8G3pI4SrE.png" },
        { "h": 2, "n": "DJ MARIA", "f": "https://xatimg.com/image/ahgYi39SeIi4.jpg" }
      ],
      "SABATO": [
        { "h": 0, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 1, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 2, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 11, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 12, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 13, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 14, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 22, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 23, "n": "DJ GHOST", "f": "https://xatimg.com/image/SC3mpxS2WjsX.png" }
      ],
      "DOMENICA": "RIPOSO",
      "LUNEDÌ": [
        { "h": 11, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 14, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" }
      ],
      "MARTEDÌ": [
        { "h": 11, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 14, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" }
      ],
      "MERCOLEDÌ": [
        { "h": 11, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 14, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" }
      ],
      "GIOVEDÌ": [
        { "h": 11, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" },
        { "h": 14, "n": "DJ GHOST", "f": "https://xatimg.com/image/or3rbqD5I3rS.png" }
      ]
    };

    function caricaPalinsestoRemoto() {
        $.getJSON('https://peppeagosto.github.io/palinsesto.json?nocache=' + new Date().getTime())
            .done(function(data) {
                if(data && typeof data === 'object') {
                    databaseTurni = data;
                }
                aggiornaLive();
            })
            .fail(function() {
                aggiornaLive();
            });
    }

    function aggiornaLive() {
        const d = new Date();
        const indiceGiorno = d.getDay();
        const nomeGiorno = giorni[indiceGiorno];
        const nomeGiornoAccento = giorniAccenti[indiceGiorno];
        let oraAttuale = d.getHours();

        $('#giorno-live').text(nomeGiornoAccento);
        const container = $('#lista-dj').empty();
        
        const djsOggi = databaseTurni[nomeGiornoAccento] || 
                        databaseTurni[nomeGiorno] || 
                        databaseTurni[nomeGiorno.toLowerCase()] || 
                        databaseTurni[nomeGiornoAccento.toLowerCase()];

        const titoloLoc = $('#titolo-locandina');

        currentDjLivePhoto = null;

        if (!djsOggi || djsOggi === "RIPOSO" || (Array.isArray(djsOggi) && djsOggi.length === 0)) {
            titoloLoc.hide();
            let msg = (nomeGiorno === "DOMENICA") 
                ? "BUONA DOMENICA DA TUTTO LO STAFF!<br><br>DOMANI SI RIPARTE!" 
                : `OGGI (${nomeGiornoAccento}) NESSUNA DIRETTA IN PROGRAMMA<br><br>RADIO IN ROTAZIONE AUTOMATICA`;
                
            container.append(`<div style="font-size:13px; text-align:center; color:#ff00c8; padding: 25px 0; font-weight:bold; line-height: 1.5;">${msg}</div>`);
        } else {
            titoloLoc.show();
            if (Array.isArray(djsOggi)) {
                // Calcola lo slot corrente
                let currentSlotIndex = -1;
                djsOggi.forEach((dj, idx) => {
                    if (oraAttuale === Number(dj.h)) {
                        currentSlotIndex = idx;
                    }
                });

                djsOggi.forEach((dj, idx) => {
                    let djOra = Number(dj.h);
                    let èLive = (oraAttuale === djOra);
                    let fotoUrl = (dj.f && dj.f.trim() !== "") ? dj.f : "https://xatimg.com/image/or3rbqD5I3rS.png";

                    if (èLive) {
                        currentDjLivePhoto = fotoUrl;
                        document.getElementById('album-art').src = fotoUrl;
                    }
                    
                    let rotateClass = isPlaying ? "spinning" : "";
                    let classeSlot = èLive ? "live-active" : "";
                    
                    let statusLed = '';
                    if (èLive) {
                        statusLed = '<span class="led-verde"></span>';
                    } else if (currentSlotIndex !== -1 && idx < currentSlotIndex) {
                        statusLed = '<span class="led-rosso"></span>';
                    }
                    
                    let formatOra = String(djOra).padStart(2, '0');

                    container.append(`
                        <div class="slot ${classeSlot}">
                            <div class="slot-header">
                                <span class="ora">${formatOra}:00</span>
                                <span class="nome">${dj.n} ${statusLed}</span>
                            </div>
                            <div class="foto-container">
                                <img class="foto ${rotateClass}" src="${fotoUrl}" onerror="this.src='https://xatimg.com/image/or3rbqD5I3rS.png'">
                                <div class="vinyl-hole"></div>
                            </div>
                        </div>
                    `);
                });
            }
        }
    }

    caricaPalinsestoRemoto();
    setInterval(caricaPalinsestoRemoto, 60000);

    // APRI / CHIUDI LOCANDINA
    document.getElementById('btn-pali').onclick = () => {
        aggiornaLive();
        const p = document.getElementById('locandina');
        p.style.display = (p.style.display === 'block') ? 'none' : 'block';
    };
    document.getElementById('close-pali').onclick = () => {
        document.getElementById('locandina').style.display = 'none';
    };

    // CAMBIO TEMA COLORI
    function setT(colore) {
        const chassis = document.getElementById('player');
        if (colore === 'rb') {
            chassis.classList.add('rainbow-mode');
            document.documentElement.style.setProperty('--accent', '#ff00c8');
        } else {
            chassis.classList.remove('rainbow-mode');
            document.documentElement.style.setProperty('--accent', colore);
        }
    }

    // OROLOGIO
    function updateClock() {
        const now = new Date();
        const hh = String(now.getHours()).padStart(2, '0');
        const mm = String(now.getMinutes()).padStart(2, '0');
        const ss = String(now.getSeconds()).padStart(2, '0');
        document.getElementById('clock').innerText = `${hh}:${mm}:${ss}`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    // IP E LOCALITA'
    async function getVisitorInfo() {
        try {
            const res = await fetch("https://ipapi.co/json/");
            const data = await res.json();
            if(data && data.ip) {
                document.getElementById('v_ip').innerText = data.ip;
                document.getElementById('v_city').innerText = `${data.city || 'ONLINE'}`;
            }
        } catch(e) {
            document.getElementById('v_ip').innerText = "PROTETTO";
            document.getElementById('v_city').innerText = "ITALIA";
        }
    }
    getVisitorInfo();

    // COPIA BRANO
    function copySongInfo() {
        const art = document.getElementById('artist').innerText;
        const sng = document.getElementById('song').innerText;
        const full = `${art} - ${sng}`;
        navigator.clipboard.writeText(full).then(() => {
            const orig = document.getElementById('song').innerText;
            document.getElementById('song').innerText = "COPIATO!";
            setTimeout(() => { document.getElementById('song').innerText = orig; }, 1500);
        });
    }
</script>
</body>
</html>
